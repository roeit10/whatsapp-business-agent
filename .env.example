# ---- Green API (וואטסאפ) ----
# מהקונסולה של green-api.com אחרי סריקת QR
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# ---- OpenRouter (המוח של הסוכן) ----
OPENROUTER_API_KEY=
# ברירת מחדל: openai/gpt-5.6-terra ($2/$12 למיליון טוקנים)
# חלופה זולה פי 10: openai/gpt-5.6-luna ($0.20/$1.20)
OPENROUTER_MODEL=openai/gpt-5.6-terra

# ---- הנתונים של העסק ----
# ה-ID הוא החלק באמצע הכתובת: docs.google.com/document/d/<ID>/edit
# כל שלושת הקבצים חייבים להיות משותפים ב"כל מי שיש לו את הקישור — צפייה"
KNOWLEDGE_DOC_ID=
INVENTORY_SHEET_ID=
ORDERS_SHEET_ID=

# ---- פרטי העסק ----
# מלאו בפרטים שלכם. השם והטלפון מופיעים בתשובות שהסוכן שולח ללקוחות.
BUSINESS_NAME=חנות החיות
OWNER_NAME=בעל העסק
OWNER_PHONE=03-5551234

# ---- קבוצת השאלות הפנימית ----
# הקבוצה שאליה הסוכן מעביר שאלות שאין לו עליהן תשובה.
# נוצרת בפקודה:  npm run create-group -- 972501234567
# ריק = הסוכן לא מעביר שאלות, אלא מפנה את הלקוח לטלפון של בעל העסק.
OWNER_GROUP_CHAT_ID=

# ---- הגבלת גישה ----
# ריק = עונה לכל מי שכותב (ברירת המחדל לבוט שירות לקוחות)
# רשימה מופרדת בפסיקים = עונה רק למספרים האלה. להשתמש בזמן פיתוח והדגמה.
ALLOWED_SENDERS=

# ---- אופציונלי ----
PORT=3000
DATA_CACHE_SECONDS=60
MEMORY_FILE=./data/conversations.json
LEARNED_FILE=./data/learned.json
TICKETS_FILE=./data/tickets.json
